
// Velmora Prisma schema
// PostgreSQL database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  USER
  SUPPORT
  OWNER
}

enum WalletType {
  CUSTODIAL
  CONNECTED
}

enum TxStatus {
  PENDING
  RESERVED
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
  CANCELLED
}

enum TxType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  FEE
  SWAP
  ADJUSTMENT
}

// ==========================================
// USERS
// ==========================================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String?
  role          Role     @default(USER)
  isActive      Boolean  @default(true)
  isSuspended   Boolean  @default(false)
  mfaEnabled    Boolean  @default(false)
  mfaSecret     String?
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  wallets              Wallet[]
  ledgerEntries        LedgerEntry[]
  transactions         Transaction[]
  auditLogs            AuditLog[]
  supportTickets       SupportTicket[]
  redeemCodes          RedeemCode[] @relation("RedeemedBy")
  createdCodes         RedeemCode[] @relation("CreatedBy")
  adminInvitesCreated  AdminInvite[] @relation("InviteCreator")

}

// ==========================================
// WALLETS
// ==========================================

model Wallet {
  id               String     @id @default(uuid())
  userId           String
  type             WalletType
  xellarWalletId   String?    @unique
  xellarSubId      String?
  address          String?
  network          String     @default("ethereum")
  connectedAddress String?
  provider         String?
  label            String?
  isPrimary        Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  balances     Balance[]
  transactions Transaction[]

  @@index([userId])
  @@index([address])
}

// ==========================================
// BALANCES
// ==========================================

model Balance {
  id        String   @id @default(uuid())
  walletId  String
  asset     String
  network   String
  available String   @default("0")
  pending   String   @default("0")
  reserved  String   @default("0")
  updatedAt DateTime @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, asset, network])
}

// ==========================================
// TRANSACTIONS
// ==========================================

model Transaction {
  id             String    @id @default(uuid())
  reference      String    @unique
  userId         String
  walletId       String?
  type           TxType
  status         TxStatus  @default(PENDING)
  asset          String
  network        String
  amount         String
  fee            String    @default("0")
  fromAddress    String?
  toAddress      String?
  txHash         String?
  providerRef    String?
  idempotencyKey String?   @unique
  metadata       String?
  failureReason  String?
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  user         User          @relation(fields: [userId], references: [id])
  wallet       Wallet?       @relation(fields: [walletId], references: [id])
  ledgerEntries LedgerEntry[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ==========================================
// LEDGER ENTRIES
// ==========================================

model LedgerEntry {
  id            String   @id @default(uuid())
  transactionId String?
  userId        String
  walletId      String?
  account       String
  direction     String
  amount        String
  asset         String
  balanceAfter  String?
  note          String?
  createdAt     DateTime @default(now())

  transaction Transaction? @relation(fields: [transactionId], references: [id])
  user        User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([transactionId])
}

// ==========================================
// AUDIT LOGS
// ==========================================

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String?
  action     String
  resource   String?
  resourceId String?
  ip         String?
  userAgent  String?
  details    String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([createdAt])
}

// ==========================================
// SUPPORT TICKETS
// ==========================================

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String
  subject   String
  status    String   @default("open")
  priority  String   @default("normal")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  messages TicketMessage[]

  @@index([userId])
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  senderId  String?
  isStaff   Boolean  @default(false)
  body      String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

// ==========================================
// SYSTEM CONFIGURATION
// ==========================================

model SystemConfig {
  id                      String   @id @default("global")
  withdrawalEnabled       Boolean  @default(true)
  dailyWithdrawalLimitUsd String   @default("10000")
  minWithdrawal           String   @default("0.001")
  feeBps                  Int      @default(500)
  appName                 String   @default("Velmora")
  treasuryAddress         String?
  updatedAt               DateTime @updatedAt
  updatedBy               String?
}

// ==========================================
// REDEEM CODES
// ==========================================

model RedeemCode {
  id            String    @id @default(uuid())
  code          String    @unique
  asset         String
  network       String    @default("ethereum")
  amount        String
  status        String    @default("active")
  expiresAt     DateTime?
  redeemedAt    DateTime?
  redeemedById  String?
  createdById   String?
  batchId       String?
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  redeemedBy User? @relation("RedeemedBy", fields: [redeemedById], references: [id])
  createdBy  User? @relation("CreatedBy", fields: [createdById], references: [id])

  @@index([status])
  @@index([batchId])
  @@index([redeemedById])
}

// ==========================================
// SUPPORTED ASSETS
// ==========================================

model SupportedAsset {
  id              String   @id
  symbol          String
  name            String
  network         String
  chainId         Int?
  decimals        Int
  isNative        Boolean  @default(true)
  tokenAddress    String?
  explorer        String?
  xellarSupported Boolean  @default(false)
  enabled         Boolean  @default(true)
  notes           String?
  updatedAt       DateTime @updatedAt
  updatedBy       String?
}

// ==========================================
// ADMIN INVITATIONS
// ==========================================

model AdminInvite {
  id          String    @id @default(uuid())
  email       String
  role        Role      @default(SUPPORT)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  createdBy User? @relation("InviteCreator", fields: [createdById], references: [id])

  @@index([email])
}

// ==========================================
// XELLAR WEBHOOK EVENTS
// ==========================================

model WebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  payload     String
  status      String   @default("accepted")
  error       String?
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
}
